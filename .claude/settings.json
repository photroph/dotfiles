{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(gh pr create *)",
      "Bash(gh * pr create *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "remoteControlAtStartup": true,
  "preferredNotifChannel": "iterm2",
  "agentPushNotifEnabled": true
}
