[core]
    pager = delta
[fetch]
    prune = true
[interactive]
    diffFilter = delta --color-only --features=interactive
[merge]
	ff = false
[pull]
	ff = only
[diff]
    algorithm = histogram
[alias]
	co = checkout
    cm = commit -m
    ft = fetch
    mg = merge
	st = status
	br = branch
	sw = switch
[init]
	defaultBranch = main
[include]
    path = ~/dotfiles/git/themes.gitconfig
[delta]
    dark = true
    header = true
    # features = collared-trogon
    # features = gruvmax-fang
    features = mantis-shrimp-lite
    line-numbers = true
    side-by-side = true
    syntax-theme = Solarized (dark)
    true-color = always
[ghq]
    root = ~/ghq
# マシン固有の設定は Git 管理外のファイルで上書きする。
[include]
    path = ~/dotfiles/.gitconfig.local
